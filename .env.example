# Search-query backend
QUERY_SOURCE=llm

# Choose: ollama, openai, or anthropic
LLM_PROVIDER=ollama

# Ollama defaults to gemma4:cloud when this is blank.
# OpenAI-compatible and Anthropic providers require a model ID.
LLM_MODEL=

# Examples:
# OpenAI:    https://api.openai.com/v1
# OpenRouter:https://openrouter.ai/api/v1
# Gemini:    https://generativelanguage.googleapis.com/v1beta/openai
# LM Studio: http://host.docker.internal:1234/v1
# Anthropic: https://api.anthropic.com/v1
LLM_BASE_URL=

# Leave blank for local endpoints that do not authenticate.
LLM_API_KEY=

LLM_TIMEOUT=180
LLM_EXTRA_HEADERS_JSON=

# Anthropic Messages settings
LLM_MAX_TOKENS=1024
LLM_ANTHROPIC_VERSION=2023-06-01

# Native Ollama host override. Useful with Docker.
OLLAMA_HOST=
